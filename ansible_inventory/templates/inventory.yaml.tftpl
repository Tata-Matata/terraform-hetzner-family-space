consul_servers:
  hosts:
%{ for idx, ip in consul_private_ips ~}
    consul-${idx + 1}:
      ansible_host: ${ip}
%{ endfor ~}

consul_clients:
  hosts: {}

consul:
  children:
    consul_servers:
    consul_clients:

vault:
  hosts:
%{ for idx, ip in vault_private_ips ~}
    vault-${idx + 1}:
      ansible_host: ${ip}
%{ endfor ~}

oidc:
  hosts:
%{ for idx, ip in oidc_private_ips ~}
    oidc-${idx + 1}:
      ansible_host: ${ip}
%{ endfor ~}

bastion:
  hosts:
    bastion-1:
      ansible_connection: local
      bastion_private_ip: ${bastion_private_ip}

#ensure single canonical bastion host in case of future HA setups and accidental multiple assignments of bastion_primary
bastion_primary:
  hosts:
    bastion-1: {}

k8s_controlplane:
  hosts:
%{ for idx, ip in k8s_controlplane_ips ~}
    k8s_controlplane-${idx + 1}:
      ansible_host: ${ip}
%{ endfor ~}


k8s_worker:
  hosts:
%{ for idx, ip in k8s_worker_ips ~}
    k8s_worker-${idx + 1}:
      ansible_host: ${ip}
%{ endfor ~}