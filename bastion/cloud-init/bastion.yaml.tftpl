#cloud-config
# this first line MUST NOT BE REMOVED, otherwise cloud-init will not recognize this file as a valid cloud-init configuration and will not execute it.s

#Cloud-init execution order is:
# -users
# -packages
# -write_files
# -runcmd
# Partials must not define runcmd. Only the composition root defines runcmd. Or you explicitly merge partials into a single runcmd list

users:
# Add 'default' user to avoid fully overriding the image's default users config.
# This preserves standard home directory and permission initialization logic.
# to troubleshoot if default user was preserved, run cat /etc/cloud/cloud.cfg | grep -i default_user -A 10
# should show the user name, for ex., ubuntu
# Then run getent passwd ubuntu, it should show the user entry. If not, then the default user was overridden
- default
- name: ansible
  # comment / full name field in /etc/passwd
  gecos: Ansible Automation User
  shell: /bin/bash
  sudo: ALL=(ALL) NOPASSWD:ALL
  groups: sudo
  lock_passwd: true
  # for access from laptop to bastion under ansible user
  ssh_authorized_keys:
  - ${admin_public_key}

packages:
- python3
- python3-venv
- python3-pip
- pipx
- git
- rsync

write_files:
# Private SSH key used by Ansible to access other nodes
- path: /home/ansible/.ssh/id_ed25519
  permissions: "0600"
  encoding: b64
  content: ${private_key_ansible}

# GitHub known_hosts entry (avoid interactive prompt)
- path: /home/ansible/.ssh/known_hosts
  permissions: "0600"
  content: ${github_ssh_host_key}

- path: /etc/ssh/sshd_config.d/99-disable-root.conf
  permissions: "0644"
  content: |
    PermitRootLogin no

runcmd:

# Create an isolated Python environment in /opt/ansible
# It’s a self-contained Ansible runtime. Has its own site-packages, does NOT use system Python packages
# Isolated from Ubuntu’s apt Python. Prevents resolvelib / dependency mismatches with apt-installed Python packages. 
# Ensures Ansible has exactly the dependencies it needs, no more, no less.

- python3 -m venv /opt/ansible
- /opt/ansible/bin/pip install --upgrade pip
- /opt/ansible/bin/pip install ansible-core==2.20.4

# When a login shell starts (ssh), /etc/profile is executed and it loads all scripts in /etc/profile.d/*.sh. 
# Then user files are loaded ~/.bashrc or ~/.profile.
# /etc/profile.d/ is a directory for system-wide shell environment extensions.
# we create /etc/profile.d/ansible.sh with the line to prepend /opt/ansible/bin to the existing PATH, 
# now it works for all users, not only ansible user
- echo 'export PATH="/opt/ansible/bin:$PATH"' > /etc/profile.d/ansible.sh
- chmod 644 /etc/profile.d/ansible.sh

# optional safety guard
- chown -R ansible:ansible /home/ansible

# Clone Ansible repo as ansible user (not root)
# Use runuser instead of sudo:
# cloud-init runs as root (no TTY), and sudo may trigger PAM/auth logic that requires a TTY, causing it to fail.
# runuser switches UID directly and is safe in non-interactive provisioning.
- runuser -l ansible -c "git clone https://github.com/Tata-Matata/ansible-family-space.git /home/ansible/ansible-family-space"

# for changes in sshd_config that disable root login 
- systemctl restart ssh
